# Source dependencies (git submodules)
# Cada plantilla vendedora del upstream — pinned a un commit estable.
[submodule "templates/admin-tailadmin/source"]
	path = templates/admin-tailadmin/source
	url = https://github.com/TailAdmin/free-nextjs-admin-dashboard.git
	branch = main
[submodule "templates/ecommerce-storefront/source"]
	path = templates/ecommerce-storefront/source
	url = https://github.com/Epic-Design-Labs/nextjs-ecommerce-starter.git
	branch = main
[submodule "templates/booking-service/source"]
	path = templates/booking-service/source
	url = https://github.com/letsopencals/template-haar.git
	branch = main
[submodule "templates/landing-marketing/source"]
	path = templates/landing-marketing/source
	url = https://github.com/ixartz/Next-JS-Landing-Page-Starter-Template.git
	branch = main